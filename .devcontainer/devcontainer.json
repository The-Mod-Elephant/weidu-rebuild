{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "weidu-rebuild",
  // mcr.microsoft.com/devcontainers/base:3.0.13-noble (multi-arch index: linux/amd64, linux/arm64).
  "image": "mcr.microsoft.com/devcontainers/base@sha256:48be4adec1c1ecbe030064700aef85382f5205786a8f82937fc44a7473717eae",
  "features": {
    // ghcr.io/devcontainers/features/nix:1.4.1
    "ghcr.io/devcontainers/features/nix@sha256:525789b2fead31ab36aa2f6fc8d2b62c5cdb5105714233c55afe77588d054dca": {
      "version": "2.35.2",
      "multiUser": true,
      "extraNixConfig": "experimental-features = nix-command flakes"
    }
  },
  // Non-root: Claude Code refuses --dangerously-skip-permissions as root.
  "remoteUser": "vscode",
  "remoteEnv": {
    "PATH": "/home/vscode/.local/bin:/home/vscode/.nix-profile/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "jnoortheen.nix-ide",
        "mkhl.direnv",
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "nix.enableLanguageServer": true,
        "nix.serverPath": "nil",
        "rust-analyzer.server.path": "rust-analyzer"
      }
    }
  }
}
