# EditorConfig: https://editorconfig.org/
# Shared editor defaults so every contributor produces byte-identical whitespace regardless of
# platform or editor. Line endings are additionally normalised by `.gitattributes`.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

# YAML (workflows, issue forms, dependabot), Nix, TOML-adjacent data and JSON use two-space
# indentation by community convention; yamlfmt and nixfmt (see hk.pkl) agree with this.
[*.{yml,yaml,nix,json,pkl}]
indent_size = 2

# Markdown uses two trailing spaces as a hard line break, so trailing whitespace is meaningful.
[*.md]
trim_trailing_whitespace = false

# The commit template is consumed by git; keep its 72-column body guidance readable.
[.gitmessage]
max_line_length = 72

# Infinity Engine game resources must stay byte-exact; editors must never rewrite them.
[*.{2da,ids,bif,bam,key,tlk,itm,spl,cre,are,wed,tis,mos,bcs,bs,sto,eff,pro,vvc,wmp,chu,dlg,gam,sav,mus,acm,wav,pvrz,bmp,png}]
charset = unset
end_of_line = unset
indent_style = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
