# https://editorconfig.org/
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.{yml,yaml,nix,json,pkl}]
indent_size = 2

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# Infinity Engine resources must stay byte-exact.
[*.{2da,ids,bif,bam,key,tlk,itm,spl,cre,are,wed,tis,mos,bcs,bs,sto,eff,pro,vvc,wmp,chu,dlg,gam,sav,mus,acm,wav,pvrz,bmp,png}]
charset = unset
end_of_line = unset
indent_style = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
